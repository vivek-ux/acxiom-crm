@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Edit Lead";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Edit Lead: @Model.LeadCode</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to List
                </a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LeadId" />
                <input type="hidden" asp-for="LeadCode" />
                <input type="hidden" asp-for="CreatedDate" />
                <input type="hidden" asp-for="ConvertedCustomerId" />
                <input type="hidden" asp-for="ConvertedOpportunityId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LeadName" class="form-label small fw-semibold">Prospect / Contact Name *</label>
                        <input asp-for="LeadName" class="form-control" required />
                        <span asp-validation-for="LeadName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label small fw-semibold">Company Name</label>
                        <input asp-for="CompanyName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address *</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">10-Digit Mobile Phone *</label>
                        <input asp-for="Phone" class="form-control" pattern="[0-9]{10}" maxlength="10" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Source" class="form-label small fw-semibold">Lead Source</label>
                        <select asp-for="Source" class="form-select">
                            <option value="Website">Website</option>
                            <option value="Referral">Referral</option>
                            <option value="Social">Social</option>
                            <option value="ColdCall">Cold Call</option>
                            <option value="Event">Event</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label small fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="New">New</option>
                            <option value="Contacted">Contacted</option>
                            <option value="Qualified">Qualified</option>
                            <option value="Converted">Converted</option>
                            <option value="Lost">Lost</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Priority" class="form-label small fw-semibold">Priority</label>
                        <select asp-for="Priority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpectedValue" class="form-label small fw-semibold">Expected Value ($)</label>
                        <input asp-for="ExpectedValue" type="number" step="1000" min="0" class="form-control" />
                        <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold">Assign to Sales Executive</label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.SalesUsers" class="form-select">
                                <option value="">-- Unassigned --</option>
                            </select>
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label small fw-semibold">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-save me-1"></i>Update Lead
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
