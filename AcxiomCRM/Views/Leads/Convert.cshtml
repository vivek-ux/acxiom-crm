@model AcxiomCRM.Models.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card p-4 shadow-sm border-top border-success border-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h4 class="fw-bold mb-0 text-success"><i class="fa-solid fa-arrows-spin me-2"></i>Convert Lead to Customer</h4>
                    <p class="text-muted small mb-0">Graduating qualified lead into active customer account and sales deal</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i>Cancel
                </a>
            </div>

            <form asp-action="Convert" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LeadId" />
                <input type="hidden" asp-for="LeadName" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Phone" />
                <input type="hidden" asp-for="CompanyName" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <!-- Customer Account Summary -->
                <div class="card bg-light p-3 mb-3 border-0">
                    <h6 class="fw-bold mb-2 text-dark">Customer Account to Create:</h6>
                    <div class="row g-2 small">
                        <div class="col-6"><strong>Name:</strong> @Model.LeadName</div>
                        <div class="col-6"><strong>Company:</strong> @(Model.CompanyName ?? "Individual")</div>
                        <div class="col-6"><strong>Email:</strong> @Model.Email</div>
                        <div class="col-6"><strong>Phone:</strong> @Model.Phone</div>
                    </div>
                </div>

                <!-- Create Deal Option -->
                <div class="mb-3 form-check">
                    <input asp-for="CreateOpportunity" class="form-check-input" id="chkCreateOpp" onchange="toggleOppFields()" />
                    <label asp-for="CreateOpportunity" class="form-check-label fw-semibold">
                        Also create a Sales Opportunity (Deal) for this Customer
                    </label>
                </div>

                <div id="oppSection" class="border rounded p-3 mb-3">
                    <h6 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-handshake me-1"></i>Opportunity Details</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label small fw-semibold">Deal Name *</label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OpportunityAmount" class="form-label small fw-semibold">Amount ($) * (Must be > 0)</label>
                            <input asp-for="OpportunityAmount" type="number" step="1000" min="1" class="form-control" />
                            <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label small fw-semibold">Win Probability (0-100%) *</label>
                            <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold">Expected Close Date * (Cannot be in past)</label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-success px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-check me-1"></i>Complete Conversion
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleOppFields() {
        const checked = document.getElementById('chkCreateOpp').checked;
        document.getElementById('oppSection').style.display = checked ? 'block' : 'none';
    }
</script>
