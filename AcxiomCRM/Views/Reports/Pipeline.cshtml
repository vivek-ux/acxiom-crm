@model IEnumerable<AcxiomCRM.Models.DTOs.PipelineReportDto>
@{
    ViewData["Title"] = "Pipeline Report";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Pipeline Stage Analysis Report</h3>
        <p class="text-muted small mb-0">Stage-by-stage revenue forecasts and probability-weighted pipeline</p>
    </div>
</div>

<div class="card p-3 mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Pipeline Stage</th>
                    <th class="text-center">Deals Count</th>
                    <th class="text-end">Total Pipeline ($)</th>
                    <th class="text-end">Weighted Value ($)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            @if (item.Stage == "Won")
                            {
                                <i class="fa-solid fa-circle-check text-success me-2"></i>
                            }
                            else if (item.Stage == "Lost")
                            {
                                <i class="fa-solid fa-circle-xmark text-danger me-2"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle-dot text-primary me-2"></i>
                            }
                            @item.Stage
                        </td>
                        <td class="text-center"><span class="badge bg-secondary">@item.Count</span></td>
                        <td class="text-end fw-bold text-dark">$@item.TotalAmount.ToString("N0")</td>
                        <td class="text-end fw-bold text-success">$@item.TotalWeightedAmount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td>Total Pipeline</td>
                    <td class="text-center">@Model.Sum(m => m.Count)</td>
                    <td class="text-end text-primary">$@Model.Sum(m => m.TotalAmount).ToString("N0")</td>
                    <td class="text-end text-success">$@Model.Sum(m => m.TotalWeightedAmount).ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
