@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activity Log";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Sales Activity Timeline</h3>
        <p class="text-muted small mb-0">Record of calls, meetings, emails, and tasks performed</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-plus me-1"></i>Log Activity
    </a>
</div>

<!-- Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Subject & Description</th>
                    <th>Associated With</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-light text-dark border">@item.ActivityType</span></td>
                            <td>
                                <div class="fw-semibold">@item.Subject</div>
                                <div class="text-muted small">@item.Description</div>
                            </td>
                            <td>@(item.Customer?.CustomerName ?? item.Lead?.LeadName ?? "General")</td>
                            <td><span class="badge bg-success">@item.Status</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No activities logged.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
