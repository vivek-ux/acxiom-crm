@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card p-5 shadow-sm border-danger">
            <div class="text-danger mb-3">
                <i class="fa-solid fa-ban fa-4x"></i>
            </div>
            <h2 class="fw-bold text-danger">403 - Access Denied</h2>
            <p class="text-muted mt-2">
                Your role does not have permission to access this module or administrative record under AcxiomCRM Role-Based Authorization Policy.
            </p>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="fa-solid fa-arrow-left me-2"></i>Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
