@model AcxiomCRM.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Secure Login";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg p-4">
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-2">
                    <i class="fa-solid fa-lock fa-2x"></i>
                </div>
                <h3 class="fw-bold">Sign In to AcxiomCRM</h3>
                <p class="text-muted small">Role-Based Enterprise Sales Portal</p>
            </div>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control" id="emailInput" placeholder="name@acxiom.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-key text-muted"></i></span>
                        <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small">Remember this device</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
                </button>
            </form>

            <hr class="my-4">

            <div class="text-center">
                <p class="text-muted small mb-2 fw-semibold">⚡ Quick Demo Login (1-Click Fill):</p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-danger btn-sm text-start" onclick="fillCreds('admin@acxiom.com', 'Admin@123')">
                        <i class="fa-solid fa-shield-halved me-2"></i><strong>Admin</strong> (Full System & Audit)
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm text-start" onclick="fillCreds('manager@acxiom.com', 'Manager@123')">
                        <i class="fa-solid fa-user-tie me-2"></i><strong>Manager</strong> (Team Scoped)
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm text-start" onclick="fillCreds('sales@acxiom.com', 'Sales@123')">
                        <i class="fa-solid fa-user me-2"></i><strong>Sales Executive</strong> (Assigned Scoped)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function fillCreds(email, password) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = password;
    }
</script>
