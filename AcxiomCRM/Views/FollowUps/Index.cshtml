@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Management";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Follow-Up Schedules & Reminders</h3>
        <p class="text-muted small mb-0">Manage customer touchpoints, calls, meetings, and activity completion</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-plus me-1"></i>Schedule Follow-Up
    </a>
</div>

<!-- Filter Card -->
<div class="card p-3 mb-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Planned" selected="@(ViewBag.Status == "Planned")">Planned</option>
                <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                <option value="Missed" selected="@(ViewBag.Status == "Missed")">Missed</option>
                <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-4">
            <select name="type" class="form-select form-select-sm">
                <option value="">All Interaction Types</option>
                <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                <option value="Task" selected="@(ViewBag.Type == "Task")">Task</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-sm flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Scheduled Date</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var isOverdue = item.Status == "Planned" && item.FollowUpDate < DateTime.UtcNow;
                        <tr>
                            <td>
                                <strong class="@(isOverdue ? "text-danger" : "text-dark")">@item.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</strong>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.FollowUpType</span></td>
                            <td>
                                <div class="fw-semibold">@item.Subject</div>
                                @if (!string.IsNullOrWhiteSpace(item.Remarks))
                                {
                                    <div class="text-muted small">@item.Remarks</div>
                                }
                            </td>
                            <td>@(item.Customer?.CustomerName ?? item.Lead?.LeadName ?? "General Account")</td>
                            <td>
                                @if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (item.Status == "Planned")
                                {
                                    <span class="badge bg-warning text-dark">Planned</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.Status == "Planned")
                                {
                                    <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm py-0 px-2 fw-semibold" title="Mark as Completed">
                                            <i class="fa-solid fa-check me-1"></i>Complete
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-inbox fa-2x mb-2 d-block text-secondary"></i>
                            No follow-ups recorded.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
