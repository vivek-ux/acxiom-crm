@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Schedule Follow-Up";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Schedule Customer Follow-Up</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back
                </a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label small fw-semibold">Customer</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                            <option value="">-- Associate Customer --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label small fw-semibold">Lead</label>
                        <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                            <option value="">-- Associate Lead --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FollowUpDate" class="form-label small fw-semibold">Follow-Up Date & Time * (Cannot be earlier than today)</label>
                        <input asp-for="FollowUpDate" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FollowUpType" class="form-label small fw-semibold">Interaction Type</label>
                        <select asp-for="FollowUpType" class="form-select">
                            <option value="Call">Phone Call</option>
                            <option value="Meeting">Meeting / Demo</option>
                            <option value="Email">Email Communication</option>
                            <option value="Task">Internal Task</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Subject" class="form-label small fw-semibold">Subject / Purpose *</label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Discuss Q1 pricing milestones" required />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label small fw-semibold">Agenda / Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Context notes, talking points..."></textarea>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-calendar-plus me-1"></i>Schedule Follow-Up
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
