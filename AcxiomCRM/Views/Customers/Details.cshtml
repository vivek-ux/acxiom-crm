@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Customer Profile";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">@Model.CustomerName <span class="badge bg-secondary fs-6">@Model.CustomerCode</span></h3>
        <p class="text-muted small mb-0">Account details and full 360-degree sales lifecycle activity</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary btn-sm me-1">
            <i class="fa-solid fa-pen me-1"></i>Edit Customer
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3 mb-3">
            <h6 class="fw-bold border-bottom pb-2 mb-3">Account Overview</h6>
            <div class="mb-2"><span class="text-muted small d-block">Company / Entity:</span><strong>@(Model.CompanyName ?? "N/A")</strong></div>
            <div class="mb-2"><span class="text-muted small d-block">Email:</span><a href="mailto:@Model.Email">@Model.Email</a></div>
            <div class="mb-2"><span class="text-muted small d-block">Phone:</span>@Model.Phone</div>
            <div class="mb-2"><span class="text-muted small d-block">Location:</span>@(Model.City ?? "—"), @(Model.State ?? "—")</div>
            <div class="mb-2"><span class="text-muted small d-block">Status:</span><span class="badge bg-success">@Model.Status</span></div>
            <div class="mb-2"><span class="text-muted small d-block">Created Date:</span>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
        </div>
    </div>

    <div class="col-md-8">
        <!-- Related Opportunities -->
        <div class="card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0"><i class="fa-solid fa-handshake me-2 text-primary"></i>Linked Opportunities</h6>
                <a asp-controller="Opportunities" asp-action="Create" class="btn btn-sm btn-outline-primary py-0">Add Deal</a>
            </div>
            @if (Model.Opportunities.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0 small">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Stage</th>
                                <th>Amount</th>
                                <th>Close Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var opp in Model.Opportunities)
                            {
                                <tr>
                                    <td class="fw-semibold">@opp.OpportunityName</td>
                                    <td><span class="badge bg-info">@opp.Stage</span></td>
                                    <td class="fw-bold">$@opp.Amount.ToString("N0")</td>
                                    <td>@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No active opportunities linked to this customer.</p>
            }
        </div>

        <!-- Follow-Ups -->
        <div class="card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0"><i class="fa-solid fa-calendar-check me-2 text-warning"></i>Follow-Up Schedule</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-warning py-0">Schedule</a>
            </div>
            @if (Model.FollowUps.Any())
            {
                <ul class="list-group list-group-flush small">
                    @foreach (var fu in Model.FollowUps)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="text-dark">@fu.Subject</strong>
                                <span class="badge bg-light text-dark border ms-2">@fu.FollowUpType</span>
                                <div class="text-muted small">@fu.FollowUpDate.ToString("g") &bull; @fu.Remarks</div>
                            </div>
                            <span class="badge @(fu.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@fu.Status</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small mb-0">No follow-ups recorded.</p>
            }
        </div>
    </div>
</div>
