@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Customer Master Data</h3>
        <p class="text-muted small mb-0">Manage authorized customer accounts, contacts, and activity histories</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-plus me-1"></i>Add Customer
    </a>
</div>

<!-- Search & Filter Card (Section 17.13) -->
<div class="card p-3 mb-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, email, phone, company..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-sm flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Customer Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Code</th>
                    <th>Customer / Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City / State</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.CustomerCode</td>
                            <td>
                                <div class="fw-semibold">@item.CustomerName</div>
                                <div class="text-muted small">@(item.CompanyName ?? "Individual")</div>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>@(item.City ?? "—"), @(item.State ?? "—")</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-outline-info btn-sm py-0 px-2" title="Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-primary btn-sm py-0 px-2" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                @if (item.Status == "Active")
                                {
                                    <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate customer @item.CustomerName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Deactivate">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-inbox fa-2x mb-2 d-block text-secondary"></i>
                            No customer records found matching the criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
