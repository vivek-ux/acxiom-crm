@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Create Customer";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Add New Customer</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to List
                </a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label small fw-semibold">Customer / Account Name *</label>
                        <input asp-for="CustomerName" class="form-control" placeholder="e.g. Acme Corporation" required />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label small fw-semibold">Company / Parent Entity</label>
                        <input asp-for="CompanyName" class="form-control" placeholder="e.g. Acme Holdings" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address *</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="contact@acme.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">10-Digit Mobile Phone *</label>
                        <input asp-for="Phone" class="form-control" placeholder="9876543210" pattern="[0-9]{10}" maxlength="10" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label small fw-semibold">Business Address</label>
                        <input asp-for="Address" class="form-control" placeholder="Street Address, Tech Park, etc." />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="City" class="form-label small fw-semibold">City</label>
                        <input asp-for="City" class="form-control" placeholder="e.g. Bengaluru" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="State" class="form-label small fw-semibold">State</label>
                        <input asp-for="State" class="form-control" placeholder="e.g. Karnataka" />
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="col-md-4">
                            <label asp-for="OwnerId" class="form-label small fw-semibold">Assigned Sales Executive</label>
                            <select asp-for="OwnerId" asp-items="ViewBag.SalesUsers" class="form-select">
                                <option value="">-- Select Sales Executive --</option>
                            </select>
                        </div>
                    }
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-save me-1"></i>Save Customer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
