@model AcxiomCRM.Models.ViewModels.ResetUserPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4 shadow-sm">
            <h4 class="fw-bold mb-1">Administrative Password Reset</h4>
            <p class="text-muted small mb-3">Reset credentials for: <strong>@Model.Email</strong></p>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold">New Password (min 8 chars, 1 uppercase, 1 digit) *</label>
                    <input asp-for="NewPassword" type="password" class="form-control" required />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
                    <button type="submit" class="btn btn-warning btn-sm px-4 fw-semibold">
                        <i class="fa-solid fa-key me-1"></i>Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
