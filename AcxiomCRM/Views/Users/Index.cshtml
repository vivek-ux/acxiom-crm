@model IEnumerable<AcxiomCRM.Models.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">User & Role Administration</h3>
        <p class="text-muted small mb-0">Manage security accounts, role assignments, password resets, and account lockouts</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-user-plus me-1"></i>Add New User
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>User Details</th>
                    <th>Email / Username</th>
                    <th>Role</th>
                    <th>Lockout Status</th>
                    <th>Failed Attempts</th>
                    <th>Created</th>
                    <th class="text-end">Security Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <i class="fa-solid fa-circle-user text-secondary me-2"></i>@user.FullName
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-danger">Administrator</span>
                            }
                            else if (user.Role == "Manager")
                            {
                                <span class="badge bg-primary">Sales Manager</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Sales Executive</span>
                            }
                        </td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-danger"><i class="fa-solid fa-lock me-1"></i>Locked</span>
                            }
                            else
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-unlock me-1"></i>Active</span>
                            }
                        </td>
                        <td>@user.AccessFailedCount / 3</td>
                        <td>@user.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-warning btn-sm py-0 px-2" title="Reset Password">
                                <i class="fa-solid fa-key"></i>
                            </a>
                            <form asp-action="ToggleLockout" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn @(user.IsLockedOut ? "btn-outline-success" : "btn-outline-danger") btn-sm py-0 px-2" title="@(user.IsLockedOut ? "Unlock Account" : "Lock Account")">
                                    <i class="fa-solid @(user.IsLockedOut ? "fa-unlock" : "fa-lock")"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
