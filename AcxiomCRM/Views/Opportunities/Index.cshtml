@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Pipeline";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Sales Opportunities & Deals</h3>
        <p class="text-muted small mb-0">Track pipeline stages, deal probabilities, and revenue forecasts</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-plus me-1"></i>New Opportunity
    </a>
</div>

<!-- Search & Filter Card (Section 17.13) -->
<div class="card p-3 mb-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="fa-solid fa-search"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by deal name, customer..." />
            </div>
        </div>
        <div class="col-md-2">
            <select name="stage" class="form-select form-select-sm">
                <option value="">All Stages</option>
                <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-sm flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Opportunities Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer / Account</th>
                    <th>Stage</th>
                    <th>Amount</th>
                    <th>Win Prob.</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.OpportunityName</td>
                            <td>@(item.Customer?.CustomerName ?? item.Lead?.LeadName ?? "Prospect")</td>
                            <td>
                                @if (item.Stage == "Won")
                                {
                                    <span class="badge bg-success">Won</span>
                                }
                                else if (item.Stage == "Lost")
                                {
                                    <span class="badge bg-danger">Lost</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@item.Stage</span>
                                }
                            </td>
                            <td class="fw-bold text-dark">$@item.Amount.ToString("N0")</td>
                            <td>
                                <div class="progress" style="height: 6px; width: 60px;">
                                    <div class="progress-bar bg-success" style="width: @item.Probability%;"></div>
                                </div>
                                <span class="text-muted" style="font-size: 0.75rem;">@item.Probability%</span>
                            </td>
                            <td class="text-muted fw-semibold">$@item.WeightedAmount.ToString("N0")</td>
                            <td>@item.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-info btn-sm py-0 px-2" title="Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary btn-sm py-0 px-2" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Delete opportunity @item.OpportunityName?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-inbox fa-2x mb-2 d-block text-secondary"></i>
                            No opportunities found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
